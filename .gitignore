# ── 依赖 ────────────────────────────────────────────────────────────────
node_modules/

# ── 本地测试沙盘与草稿 ──────────────────────────────────────────────────
# .test-tmp 里是从 app.asar 提取的 runtime、fake DSH home 和验收脚本产物
# （约 456MB），.scratch 是临时草稿，都不进仓库。
.test-tmp/
.scratch/

# ── 内部工作稿（只在本机，不入库、不进 npm 包）───────────────────────────
# 方案稿、任务拆分、发布清单这类过程文档；面向用户的文档留在 README/INSTALL/
# CHANGELOG/docs。需要时直接看本地 notes/ 目录。
notes/

# ── 构建产物 / 缓存 ─────────────────────────────────────────────────────
dist/
build/
coverage/
.cache/
*.tsbuildinfo

# ── 日志与临时文件 ──────────────────────────────────────────────────────
*.log
*.tmp
*.tmp-*
*.bak
*.bak-*

# ── 本地环境变量（示例文件可以提交）─────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── 编辑器 / 操作系统 ───────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*~

# ── 包管理器 ────────────────────────────────────────────────────────────
*.tgz
.npm-cache/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
